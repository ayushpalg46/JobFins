# ==============================================================================
# JobFins - Production & Local Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE VARIABLES (Set these in Railway -> jobfins-backend -> Variables)
# ------------------------------------------------------------------------------

# Aiven MySQL JDBC Connection URL
# Replace <host>, <port>, and <dbname> with your details from the Aiven Console
SPRING_DATASOURCE_URL=jdbc:mysql://<aiven-host>:<port>/<dbname>?sslmode=require

# Aiven MySQL Username (typically avnadmin)
SPRING_DATASOURCE_USERNAME=avnadmin

# Aiven MySQL Password
SPRING_DATASOURCE_PASSWORD=your_aiven_password_here

# Port for Spring Boot (Railway sets this dynamically, defaults to 8080)
PORT=8080

# Hibernate Auto DDL (update ensures tables are created/migrated safely)
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ------------------------------------------------------------------------------
# 2. FRONTEND SERVICE VARIABLES (Set these in Railway -> jobfins-frontend -> Variables)
# ------------------------------------------------------------------------------

# Live URL of your deployed jobfins-backend service with '/api' suffix
# Example: https://jobfins-backend-production-xxxx.up.railway.app/api
VITE_API_BASE_URL=https://<your-backend-railway-domain>/api
